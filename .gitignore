# ============================================================================
#  标注工坊 DrawX —— 仓库里只放源码、测试、文档和打包脚本
#  所有产物（exe、截图、测试输出、示例工程）都写在 build\ 下，整目录不入库；
#  虚拟环境同理。克隆后按 README 一条命令重建。
# ============================================================================

# ---------- 构建产物 ----------
# packaging\build.ps1 的 exe/中间产物、tests\ 与 devtools\ 的截图和测试输出、
# 示例工程 *.drawx —— 全都在 build\ 下，整目录忽略。
build/
dist/
*.spec
*.out

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/

# ---------- 各类缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- 编辑器 / 操作系统 ----------
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
~$*

# ---------- 运行期产物 ----------
*.log
*.tmp
